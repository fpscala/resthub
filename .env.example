# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Webhook URL (must be publicly accessible)
# For development: use ngrok or similar service
# For production: your domain name
TELEGRAM_WEBHOOK_URL=https://your-domain.com

# Database Configuration (optional - defaults from docker-compose)
DATABASE_URL=jdbc:postgresql://localhost:5432/nesthub
DATABASE_USER=nesthub_user
DATABASE_PASSWORD=nesthub_password

# Redis Configuration (optional - defaults from docker-compose)
REDIS_URL=redis://localhost:6379

# AWS S3 Configuration (optional - defaults from docker-compose)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=nesthub-uploads
AWS_REGION=us-east-1

# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Backend Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=INFO